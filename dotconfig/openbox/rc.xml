<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.0/rc">
  
  <menu>
    <file>/home/a7med/.config/openbox/menu.xml</file>
  </menu>

  <keyboard>
    <!-- Basic Window Controls -->
    <keybind key="W-m"><action name="Iconify"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="C-A-Delete"><action name="Exit"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><finalactions><action name="Focus"/><action name="Raise"/></finalactions></action></keybind>
    <keybind key="F11"><action name="ToggleFullscreen"/></keybind>

    <!-- Open Menu with Win+A -->
    <keybind key="W-a">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </keybind>

    <!-- PipeWire Audio Controls -->
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+</command></action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action>
    </keybind>

    <!-- Brightness Controls -->
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute"><command>brightnessctl set 5%-</command></action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute"><command>brightnessctl set 5%+</command></action>
    </keybind>
  </keyboard>
  <mouse>
    <dragThreshold>1</dragThreshold>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="W-Right" action="Drag"><action name="Move"/></mousebind>
    </context>
  </mouse>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse> <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <theme>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify> <font place="ActiveWindow"><name>sans</name><size>8</size></font>
  </theme>

  <applications>
    <application name="*">
      <decor>no</decor>
      <shade>no</shade>
      <focus>yes</focus>
    </application>
    <application name="steam">
      <fullscreen>yes</fullscreen>
    </application>
  </applications>
</openbox_config>
